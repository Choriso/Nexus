# =============================================================================
# Flask — основные настройки веб-приложения
# =============================================================================

# Секретный ключ для сессий и CSRF (обязателен в production)
SECRET_KEY=bolt_and_nut_secret_123

# Точка входа Flask-приложения
FLASK_APP=App.py

# Режим окружения: development | production | testing
FLASK_ENV=development

# Хост и порт для запуска сервера разработки
FLASK_HOST=0.0.0.0
FLASK_PORT=3000

# Папка для загружаемых файлов пользователей
UPLOAD_FOLDER=static/uploads/

# Максимальный размер загружаемого файла в байтах (по умолчанию 16 МБ)
MAX_CONTENT_LENGTH=16777216

# Разрешённые origins для CORS и SocketIO (через запятую; пусто = *)
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# База данных
# =============================================================================

# Строка подключения SQLAlchemy
# Формат PostgreSQL: postgresql://ЛОГИН:ПАРОЛЬ@ХОСТ:ПОРТ/ИМЯ_БАЗЫ
DATABASE_URL=postgresql://my_app_user:Danil%402008@localhost:5432/nexus_db

# =============================================================================
# Seed-скрипт (tools/seed_db.py) — отдельные параметры подключения к PostgreSQL
# =============================================================================

SEED_DB_NAME=nexus_db
SEED_DB_USER=my_app_user
SEED_DB_PASSWORD=Danil@2008
SEED_DB_HOST=127.0.0.1
SEED_DB_PORT=5432

# =============================================================================
# AI / ML — модели и эмбеддинги
# =============================================================================

# True — локальные модели, False — внешний API
USE_LOCAL_AI_MODELS=True

# Модель Sentence Transformers для эмбеддингов
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Каталог для загрузки/хранения локальных моделей HuggingFace
LOCAL_MODELS_PATH=./models

# Каталог с обученными весами (.pth) для OCEAN и MBTI
LOCAL_ARTIFACTS_DIR=./ml/artifacts

# Имена файлов весов внутри LOCAL_ARTIFACTS_DIR
PERSONALITY_MODEL_FILENAME=personality_model_best.pth
MBTI_MODEL_FILENAME=mbti_model.pth

# Вес нейросетевой MBTI-модели при смешивании с rule-based прогнозом (0.0–1.0)
NEXUS_MBTI_NEURAL_BLEND_WEIGHT=0.7

# Путь к сериализованному TF-IDF векторизатору
TFIDF_VECTORIZER_PATH=app/ai/models/tfidf_vectorizer.pkl


OLLAMA_ENABLED = True
OLLAMA_BASE_URL = "http://localhost:11434"
OLLAMA_MODEL = "qwen2.5:1.5b-instruct-q4_K_M"
OLLAMA_TIMEOUT = 120
DUCKDUCKGO_ENABLED = True
CONTEXTUAL_ADAPTER_ENABLED = True
# =============================================================================
# Celery — фоновые задачи анализа профиля
# =============================================================================

# Команда для запуска celery-worker: celery -A app.ai.personality_analyzer worker --loglevel=info --pool=solo
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =============================================================================
# Redis — кэш и rate limiting
# =============================================================================

REDIS_URL=redis://localhost:6379/1

# =============================================================================
# Анализ профилей пользователей
# =============================================================================

# Минимум сообщений для запуска анализа
MIN_MESSAGES_FOR_ANALYSIS=5

# Пауза между повторными анализами одного пользователя (секунды)
ANALYSIS_COOLDOWN=3600

# Автозапуск анализа каждые N новых сообщений
ANALYSIS_MESSAGE_TRIGGER=10

# Максимум сообщений, загружаемых из БД за один анализ (Celery task)
MAX_MESSAGES_PER_ANALYSIS=50

# =============================================================================
# Совместимость пользователей
# =============================================================================

# TTL кэша результатов совместимости (секунды)
COMPATIBILITY_CACHE_TTL=86400

# Минимальный порог совместимости для рекомендаций (0.0–1.0)
MIN_COMPATIBILITY_SCORE=0.6

# =============================================================================
# Семантический поиск
# =============================================================================

# Порог сходства для включения результата в выдачу (0.0–1.0)
SEMANTIC_SEARCH_THRESHOLD=0.5

# Максимальное количество результатов поиска
MAX_SEARCH_RESULTS=20

# =============================================================================
# Приватность и безопасность
# =============================================================================

# Требовать явное согласие пользователя на AI-анализ
REQUIRE_ANALYSIS_CONSENT=True

# Анонимизировать данные при обучении моделей
ANONYMIZE_TRAINING_DATA=True

# Срок хранения истории чата для анализа (дней)
MAX_CHAT_HISTORY_DAYS=90

# =============================================================================
# Rate Limiting
# =============================================================================

# Включить ограничение частоты запросов
RATELIMIT_ENABLED=True

# Лимиты для AI-эндпоинтов
AI_ANALYSIS_RATE_LIMIT=5/hour
AI_COMPATIBILITY_RATE_LIMIT=20/hour
AI_SEARCH_RATE_LIMIT=30/hour

# =============================================================================
# Мониторинг и логирование AI
# =============================================================================

# Записывать операции AI в лог
LOG_AI_OPERATIONS=True

# Уровень логирования AI: DEBUG | INFO | WARNING | ERROR
AI_LOG_LEVEL=INFO
